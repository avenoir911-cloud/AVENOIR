+    const fire = () => { if (fired) return; fired = true; clearInterval(timer); removeEventListener('scroll', onScroll); try { sessionStorage.setItem('avn_eng', '1'); } catch (e) {} window.dataLayer.push({ event: 'Engaged' }); collect('Engaged', {}); };
+    const onScroll = () => { const h = document.documentElement.scrollHeight; if (scrollY > 0 && (scrollY + innerHeight) / h >= 0.5) fire(); };
